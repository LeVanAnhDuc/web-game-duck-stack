#!/usr/bin/env bash
# Git hook: gac commit bang `tsc` tren CA project.
#
# Bat cung co che voi commit-msg:
#
#     git config core.hooksPath .githooks
#
# Vi sao `tsc` chu khong phai ESLint (R-22): repo nay KHONG co ESLint — khong config,
# khong devDependency, khong script. Dung linter la mot viec rieng (xem
# 04-state/backlog.md §No ky thuat). Trong khi cho, `tsc` la thu gac duy nhat co that,
# va no chay het trong ~1s nen dat vao pre-commit khong lam ai phai cho.
#
# `tsc` khong loc theo file staged duoc: kiem mot phan cay kieu thi khong co nghia gi.
#
# Day la phan hoi nhanh, KHONG phai rao chan: `core.hooksPath` khong theo duoc
# `git clone`, va `--no-verify` bo qua duoc. Rao chan that la CI.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

# Moi package mot cay kieu rieng: client/ (game) va automation-testing/ (bo test hoi
# quy). Chi kiem package co file .ts/.tsx staged — va chi khi package do da cai
# dependency, vi `tsc` cua no nam trong node_modules cua chinh no.
check() {
  dir="$1"
  if ! git diff --cached --name-only --diff-filter=ACMR -- "$dir/*.ts" "$dir/*.tsx" | grep -q .; then
    return 0
  fi
  if [ ! -d "$dir/node_modules" ]; then
    printf '  pre-commit: bo qua typecheck cua %s/ (chua pnpm install)\n' "$dir" >&2
    return 0
  fi
  if ! (cd "$dir" && pnpm --silent typecheck); then
    printf '\n  Commit bi chan: tsc bao loi kieu trong %s/.\n' "$dir" >&2
    printf '  Xem lai        : cd %s && pnpm typecheck\n' "$dir" >&2
    printf '  Bo qua co chu dich (hiem): git commit --no-verify\n\n' >&2
    return 1
  fi
}

check client || exit 1
check automation-testing || exit 1
