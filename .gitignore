
# Worktree của feature. `.claude/` bị ignore nên worktree không checkout được nó;
# .claude/scripts/worktree-new.sh copy vào, worktree-done.sh xoá đi. Xem ADR-0007.
/.worktrees/

# Bí mật — `.env.example` là bản mẫu và ĐƯỢC commit; `.env` là bản thật và không bao giờ commit.
.env
.env.*
!.env.example

# Toolchain
node_modules/
dist/
coverage/

# --- Claude Code: theo doi config + skills, bo qua worktrees/doc-state ---
/.claude/*
!/.claude/CLAUDE.md
!/.claude/settings.local.json
!/.claude/skills/
!/.claude/scripts/
# Agent cua skill ux-persona-review. Skill duoc commit ma agent thi khong la skill
# chay khong duoc tren mot clone moi hoac trong worktree: Claude Code bao khong tim
# thay agent type, va khong co cach nao sinh lai tu trong repo nay.
!/.claude/agents/

# Repo nay dung npm (package-lock.json). Mot yarn.lock lot vao la hai lockfile
# trong mot repo: CI cai bang mot cai, nguoi dev cai bang cai kia.
yarn.lock

# Rac cua playwright MCP: snapshot a11y tree + anh tam moi lan lai trinh duyet.
# Sinh ra khi chay skill ux-persona-review, khong phai mot phan cua san pham.
/.playwright-mcp/
